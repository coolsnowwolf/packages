Subject: [PATCH] xpon: use Linux 7.3 parser and unaligned headers

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/airoha-xpon-oam.c
+++ b/airoha-xpon-oam.c
@@ -6,7 +6,7 @@
 #include <linux/device.h>
 #include <linux/crc32.h>
 #include <linux/if_ether.h>
-#include <asm/unaligned.h>
+#include <linux/unaligned.h>
 #include <linux/if_arp.h>
 #include <linux/netdevice.h>
 #include <linux/rtnetlink.h>
--- a/airoha-xpon-private.h
+++ b/airoha-xpon-private.h
@@ -1,3 +1,4 @@
+#include <linux/hex.h>
 /* SPDX-License-Identifier: GPL-2.0-only */
 #ifndef _AIROHA_XPON_PRIVATE_H_
 #define _AIROHA_XPON_PRIVATE_H_
