+++ b/airoha-xpon-private.h
@@ -19,6 +19,7 @@
 struct crypto_sync_skcipher;
 struct device;
 struct net_device;
+struct airoha_pon_pcs;
 struct phylink_pcs;
 struct regmap;
 struct airoha_xpon_omci;
@@ -231,7 +232,11 @@
 	struct regmap *scu;
 	struct airoha_pon_frontend *frontend;
 	struct airoha_pon_frontend_link_config frontend_link;
+#if IS_ENABLED(CONFIG_AIROHA_BSP_PON_PCS)
