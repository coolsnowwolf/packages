Subject: [PATCH] airoha-xpon: support Linux 6.18 mainline and BSP providers

Select the BSP provider API only when its kernel configuration is enabled.
Keep the standard PCS API available on kernels using the mainline driver.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>
Signed-off-by: lean <chenlin@fnnas.com>
---
--- a/Makefile
+++ b/Makefile
@@ -8,3 +8,8 @@
 	airoha-xpon-control.o airoha-xpon-diagnostics.o airoha-xpon-epon.o \
 	airoha-xpon-omci.o airoha-xpon-oam.o \
 	airoha-xpon-leds.o
+
+ccflags-$(CONFIG_AIROHA_BSP_PON_PCS) += -include linux/airoha-compat.h
+
+# Catch newer-kernel API signature changes during the 5.4 port.
+ccflags-y += -Werror=incompatible-pointer-types -Werror=int-conversion
--- a/airoha-xpon-main.c
+++ b/airoha-xpon-main.c
@@ -10,7 +10,9 @@
 #include <linux/of.h>
 #include <linux/of_net.h>
 #include <linux/pcs/pcs-airoha.h>
+#if !IS_ENABLED(CONFIG_AIROHA_BSP_PON_PCS)
 #include <linux/pcs/pcs.h>
+#endif
 #include <linux/platform_device.h>
 #include <linux/property.h>
 #include <linux/mfd/syscon.h>
@@ -632,7 +634,11 @@
 		                     "failed to obtain the SCU regmap\n");
 
 	/* pcs-handle identifies the provider that owns PCS/PMA registers. */
+#if IS_ENABLED(CONFIG_AIROHA_BSP_PON_PCS)
+	xpon->pcs = devm_airoha_pon_pcs_get(dev);
+#else
 	xpon->pcs = fwnode_pcs_get(dev_fwnode(dev), 0);
+#endif
 	if (IS_ERR(xpon->pcs))
 		return dev_err_probe(dev, PTR_ERR(xpon->pcs),
 		                     "failed to obtain the PON PCS provider\n");
--- a/airoha-xpon-mode.c
+++ b/airoha-xpon-mode.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0-only
 
 #include <linux/err.h>
+#include <linux/ctype.h>
 #include <linux/netdevice.h>
 #include <linux/of.h>
 #include <linux/rtnetlink.h>
@@ -11,6 +12,57 @@
 #include "airoha-xpon-oam.h"
 #include "airoha-xpon-omci.h"
 
+/* From Linux 5.4 lib/cmdline.c: next_arg is not exported to modules. */
+static char *airoha_xpon_next_arg(char *args, char **param, char **val)
+{
+	unsigned int i, equals = 0;
+	int in_quote = 0, quoted = 0;
+	char *next;
+
+	if (*args == '"') {
+		args++;
+		in_quote = 1;
+		quoted = 1;
+	}
+
+	for (i = 0; args[i]; i++) {
+		if (isspace(args[i]) && !in_quote)
+			break;
+		if (equals == 0) {
+			if (args[i] == '=')
+				equals = i;
+		}
+		if (args[i] == '"')
+			in_quote = !in_quote;
+	}
+
+	*param = args;
+	if (!equals)
+		*val = NULL;
+	else {
+		args[equals] = '\0';
+		*val = args + equals + 1;
+
+		/* Don't include quotes in value. */
+		if (**val == '"') {
+			(*val)++;
+			if (args[i-1] == '"')
+				args[i-1] = '\0';
+		}
+	}
+	if (quoted && args[i-1] == '"')
+		args[i-1] = '\0';
+
+	if (args[i]) {
+		args[i] = '\0';
+		next = args + i + 1;
+	} else
+		next = args + i;
+
+	/* Chew up trailing spaces. */
+	return skip_spaces(next);
+}
+
 static const struct airoha_xpon_mode_info airoha_xpon_modes[] = {
 	{
 		.mode = AIROHA_XPON_MODE_GPON,
@@ -139,7 +191,7 @@
 
 	cursor = args;
 	while (*cursor) {
-		cursor = next_arg(cursor, &param, &value);
+		cursor = airoha_xpon_next_arg(cursor, &param, &value);
 		if (strcmp(param, "xpon.mode"))
 			continue;
 		if (!value) {
