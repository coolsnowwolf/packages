Subject: h3c-fmcs: support QWRT Linux 5.4

Adapt to the legacy driver and networking APIs. Enable the FTTR offload
adapter when the OpenWrt bridge flowtable API is available.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/Makefile
+++ b/Makefile
@@ -1,2 +1,7 @@
 obj-m += h3c-fmcs.o
 h3c-fmcs-objs := fmcs_main.o fmcs_spi.o fmcs_netdev.o fmcs_offload.o
+
+# The FTTR offload adapter uses the OpenWrt bridge flowtable API.
+ifneq ($(shell grep -l '^int dev_fill_bridge_path' $(srctree)/include/linux/netdevice.h),)
+ccflags-y += -DFMCS_FLOW_OFFLOAD
+endif
