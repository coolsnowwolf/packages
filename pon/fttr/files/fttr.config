# Management defaults to read-only planning. Apply it from LuCI Synchronization.
# Each device explicitly selects omci_adapter, bootstrap_adapter and provisioning_adapter.
# Bootstrap and business provisioning run independently; provisioning_adapter 'none' only disables business delivery.
# Bootstrap omci-acs authorizes standard OMCI ACS/VLAN writes after management Apply.
# Examples: hl202 / hl202-mqtt-acs / hl202-cu; hwtc / manual-acs / hwtc-hw.
# Direct MQTT provisioning: hl202 / none / hl202-mqtt. Disabled provisioning: generic / none / none.
# Optional settings inside each existing config device section (enabled by default):
# option connection_request '1'
# option connection_request_defaults '1'
# option connection_request_username ''
# option connection_request_password ''
# option connection_request_port '7547'
# These are existing CPE Connection Request credentials, NOT the ACS login below.
# Factory profiles are unverified/unavailable. Set defaults '0' with verified custom credentials.
# No CPE Connection Request credentials are changed.
# Authentication is disabled by default; credentials do not restrict admission.
config omci_auth 'global'
	option schema_version '1'
	option auth_mode 'disabled'

config calibration 'calibration'
	option source 'auto'

config optical 'optical'
	option enabled '1'
	option downstream_tx_enabled '1'
	option fec_enabled '0'

# FiberHome AN4475-G2 only: add these options to the named fiberhome section.
# RX snapshots default to off, are bounded, and require a restart.
# config fiberhome 'fiberhome'
# 	option onu_count '128'
# 	option rx_snapshot '0'

# Used only when fttrd is compiled with the default-enabled npu feature.
config offload 'offload'
	option enabled '1'
	option bridge 'br-lan'
	# Enable routed WAN and ONU bridge directions; port masks are separate.
	option wan_upstream '1'
	option wan_downstream '1'
	option onu_bridge '1'

config acs 'acs'
	option enabled '1'
	option port '7547'
	option path '/cwmp'
	option state_file ''
	option username ''
	option password ''
config provisioning 'provisioning'
	option enabled '1'
	option allow_unsupported_as_bridge '1'
	option mode 'auto'
	option freshness '180'
	# Per-device wait after synchronization ends; requires the periodic trigger.
	option interval_minutes '30'
	list trigger 'config_change'
	list trigger 'device_online'
	list trigger 'cwmp_boot'
	list trigger 'program_start'
	list trigger 'periodic'

config management 'management'
	option enabled '1'
	option mode 'auto'
	list vlan '46'
	option priority '0'
	option address '192.168.46.1/24'
	option dhcp_enabled '1'
	option dhcp_start '100'
	option dhcp_limit '100'
	option dhcp_leasetime '12h'

config mqtt_bridge 'mqtt_bridge'
	option enabled '0'

config acs_bridge 'acs_bridge'
	option enabled '0'
	option management_gateway '0'

config template 'home'
	option name 'Home'

config group 'home_group'
	option name 'Home'
	option template 'home'

config wifi 'wifi_2g'
	option template 'home'
	option ssid 'FTTR_2G'
	option radio '2g'

config wifi 'wifi_5g'
	option template 'home'
	option ssid 'FTTR_5G'
	option radio '5g'
