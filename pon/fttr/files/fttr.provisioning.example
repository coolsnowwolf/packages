config optical 'optical'
	option enabled '1'
	option downstream_tx_enabled '1'
	option fec_enabled '0'

config acs 'acs'
	option enabled '1'
	option port '7547'
	option path '/cwmp'

config provisioning 'provisioning'
	option enabled '1'
	option allow_unsupported_as_bridge '1'
	option mode 'manual'
	option freshness '180'
	option interval_minutes '30'
	list trigger 'config_change'
	list trigger 'device_online'
	list trigger 'cwmp_boot'
	# Optional: automatically sync eligible devices after fttrd starts.
	# list trigger 'program_start'

config management 'management'
	list vlan '46'
	list vlan '47'
	option priority '0'
	option address '192.168.46.1/24'
	option mode 'manual'

config template 'home'
	option name 'Home'

config group 'home_group'
	option name 'Home'
	option template 'home'

config device 'hl202'
	option optical_sn 'H3CT00088888'
	option omci_adapter 'hl202'
	option bootstrap_adapter 'hl202-mqtt-acs'
	option provisioning_adapter 'hl202-cu'
	option group 'home_group'

config device 'k155'
	option optical_sn 'HWTC00088888'
	option omci_adapter 'hwtc'
	option bootstrap_adapter 'manual-acs'
	option provisioning_adapter 'hwtc-hw'
	option group 'home_group'

config wifi 'wifi_2g'
	option template 'home'
	option ssid 'FTTR_2G'
	option radio '2g'

config wifi 'wifi_5g'
	option template 'home'
	option ssid 'FTTR_5G'
	option radio '5g'
