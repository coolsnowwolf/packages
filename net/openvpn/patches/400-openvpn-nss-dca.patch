--- a/src/openvpn/nss_dca.c
+++ b/src/openvpn/nss_dca.c
@@ -0,0 +1,451 @@
+/*
+ * OpenVPN NSS data channel interface.
+ * The socket protocol follows Qualcomm QSDK12 NSS OpenVPN Manager.
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+#include "syshead.h"
+
+#ifdef ENABLE_NSS_DCA
+
+#include <linux/sockios.h>
+#include "openvpn.h"
+#include "nss_ovpn_sk.h"
+#include "nss_dca.h"
+#include "ping.h"
+#include "ssl_pkt.h"
+
+struct nss_dca_tunnel {
+    struct nss_dca_tunnel *next;
+    struct context *context;
+    uint32_t id;
+    int key_id;
+    int old_key_id;
+};
+
+static struct nss_dca_tunnel *tunnels;
+static int nss_fd = -1;
+static unsigned int nss_users;
+
+void
+nss_dca_export_key(struct tls_multi *multi, struct key_state *ks,
+                   const struct key_type *type, const struct key2 *keys, bool server)
+{
+    if (!multi->nss_dca || !type->cipher || !type->digest
+        || (strcasecmp(type->cipher, "AES-128-CBC")
+            && strcasecmp(type->cipher, "AES-192-CBC")
+            && strcasecmp(type->cipher, "AES-256-CBC")))
+    {
+        return;
+    }
+
+    enum nss_ovpn_sk_algo algo;
+    if (!strcasecmp(type->digest, "SHA256"))
+    {
+        algo = NSS_OVPN_SK_ALGO_AES_CBC_SHA256_HMAC;
+    }
+    else if (!strcasecmp(type->digest, "SHA1"))
+    {
+        algo = NSS_OVPN_SK_ALGO_AES_CBC_SHA1_HMAC;
+    }
+    else
+    {
+        return;
+    }
+
+    struct nss_ovpn_sk_crypto_session *crypto;
+    ALLOC_OBJ_CLEAR(crypto, struct nss_ovpn_sk_crypto_session);
+    struct key_direction_state direction;
+    key_direction_state_init(&direction, server ? KEY_DIRECTION_INVERSE : KEY_DIRECTION_NORMAL);
+    crypto->key_id = (uint8_t)ks->key_id;
+    crypto->config.algo = algo;
+    crypto->config.cipher_key_size = (uint16_t)cipher_kt_key_size(type->cipher);
+    crypto->config.hmac_key_size = md_kt_size(type->digest);
+    memcpy(crypto->encrypt.cipher_key, keys->keys[direction.out_key].cipher,
+           crypto->config.cipher_key_size);
+    memcpy(crypto->decrypt.cipher_key, keys->keys[direction.in_key].cipher,
+           crypto->config.cipher_key_size);
+    memcpy(crypto->encrypt.hmac_key, keys->keys[direction.out_key].hmac,
+           crypto->config.hmac_key_size);
+    memcpy(crypto->decrypt.hmac_key, keys->keys[direction.in_key].hmac,
+           crypto->config.hmac_key_size);
+    ks->nss_key = crypto;
+}
+
+void
+nss_dca_free_key(struct key_state *ks)
+{
+    if (ks->nss_key)
+    {
+        secure_memzero(ks->nss_key, sizeof(*ks->nss_key));
+        free(ks->nss_key);
+        ks->nss_key = NULL;
+    }
+}
+
+static void
+nss_dca_release(void)
+{
+    if (!--nss_users)
+    {
+        close(nss_fd);
+        nss_fd = -1;
+    }
+}
+
+static bool
+nss_dca_register(const struct context *c, const struct link_socket *link)
+{
+    if (nss_fd >= 0)
+    {
+        ++nss_users;
+        return true;
+    }
+
+    int fd = socket(NSS_OVPN_SK_FAMILY, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+    if (fd < 0)
+    {
+        msg(M_WARN | M_ERRNO, "NSS OpenVPN socket unavailable");
+        return false;
+    }
+
+    struct nss_ovpn_sk_app_inst app = {
+        .pid = getpid(),
+        .tun_fd = c->c1.tuntap->fd,
+        .udp_fd = link->sd,
+        .app_mode = c->mode == CM_CHILD_UDP ? NSS_OVPN_SK_APP_MODE_SERVER
+                                          : NSS_OVPN_SK_APP_MODE_CLIENT,
+    };
+    snprintf(app.tun_dev, sizeof(app.tun_dev), "%s", c->c1.tuntap->actual_name);
+
+    if (ioctl(fd, NSS_OVPN_SK_SIOC_APP_REG, &app) < 0)
+    {
+        msg(M_WARN | M_ERRNO, "NSS OpenVPN application registration failed");
+        close(fd);
+        return false;
+    }
+
+    nss_fd = fd;
+    nss_users = 1;
+    return true;
+}
+
+static void
+nss_dca_start(struct context *c, const struct key_state *ks)
+{
+    const struct link_socket *link = c->c2.link_sockets[0];
+    const struct link_socket_actual *remote = &ks->remote_addr;
+    const struct openvpn_sockaddr *peer = &remote->dest;
+    struct sockaddr_storage local = { 0 };
+    socklen_t len = sizeof(local);
+    struct nss_ovpn_sk_tunnel config = { .crypto = *ks->nss_key };
+
+    if (getsockname(link->sd, (struct sockaddr *)&local, &len) < 0
+        || local.ss_family != peer->addr.sa.sa_family)
+    {
+        return;
+    }
+
+    if (local.ss_family == AF_INET)
+    {
+        const struct sockaddr_in *in = (const struct sockaddr_in *)&local;
+
+        config.tun_hdr.src_ip[0] = in->sin_addr.s_addr;
+#ifdef IP_PKTINFO
+        if (remote->pi.in4.ipi_spec_dst.s_addr)
+        {
+            config.tun_hdr.src_ip[0] = remote->pi.in4.ipi_spec_dst.s_addr;
+        }
+#endif
+        config.tun_hdr.dst_ip[0] = peer->addr.in4.sin_addr.s_addr;
+        config.tun_hdr.src_port = in->sin_port;
+        config.tun_hdr.dst_port = peer->addr.in4.sin_port;
+    }
+    else if (local.ss_family == AF_INET6)
+    {
+        const struct sockaddr_in6 *in6 = (const struct sockaddr_in6 *)&local;
+        if (IN6_IS_ADDR_V4MAPPED(&peer->addr.in6.sin6_addr) || peer->addr.in6.sin6_scope_id)
+        {
+            return;
+        }
+
+        config.ovpn.flags = NSS_OVPN_SK_OVPN_HDR_FLAG_IPv6;
+        memcpy(config.tun_hdr.src_ip, &in6->sin6_addr, sizeof(in6->sin6_addr));
+        memcpy(config.tun_hdr.dst_ip, &peer->addr.in6.sin6_addr, sizeof(in6->sin6_addr));
+        config.tun_hdr.src_port = in6->sin6_port;
+        config.tun_hdr.dst_port = peer->addr.in6.sin6_port;
+    }
+    else
+    {
+        return;
+    }
+
+    if (c->c2.tls_multi->use_peer_id)
+    {
+        config.ovpn.flags |= NSS_OVPN_SK_OVPN_HDR_FLAG_DATA_V2
+                             | NSS_OVPN_SK_OVPN_HDR_FLAG_PEER_DATA_V2;
+        config.ovpn.peer_id = c->c2.tls_multi->peer_id;
+    }
+    if (!nss_dca_register(c, link))
+    {
+        return;
+    }
+
+    int ret = ioctl(nss_fd, NSS_OVPN_SK_SIOC_TUN_ADD, &config);
+    secure_memzero(&config.crypto, sizeof(config.crypto));
+    if (ret < 0)
+    {
+        msg(M_WARN | M_ERRNO, "NSS OpenVPN tunnel setup failed");
+        nss_dca_release();
+        return;
+    }
+
+    struct nss_dca_tunnel *tun;
+    ALLOC_OBJ_CLEAR(tun, struct nss_dca_tunnel);
+    tun->context = c;
+    tun->id = config.ovpn.tunnel_id;
+    tun->key_id = ks->key_id;
+    tun->old_key_id = -1;
+    tun->next = tunnels;
+    tunnels = tun;
+    c->c2.nss_tunnel = tun;
+    msg(M_INFO, "NSS OpenVPN data channel active on tunnel %u", tun->id);
+}
+
+static bool
+nss_dca_eligible(const struct context *c, const struct key_state *ks)
+{
+    return ks->nss_key && c->c1.tuntap && c->c1.tuntap->actual_name
+           && c->c1.tuntap->type == DEV_TYPE_TUN
+           && (c->mode == CM_P2P || c->mode == CM_CHILD_UDP)
+           && proto_is_udp(c->c2.link_sockets[0]->info.proto)
+           && !c->options.ce.socks_proxy_server && !c->options.ce.fragment
+           && !c->options.passtos
+#ifdef USE_COMP
+           && !c->c2.comp_context
+#endif
+           && !(ks->crypto_options.flags & (CO_PACKET_ID_LONG_FORM | CO_EPOCH_DATA_KEY_FORMAT));
+}
+
+static bool
+nss_dca_rekey(struct nss_dca_tunnel *tun, const struct key_state *ks)
+{
+    if (tun->key_id == ks->key_id)
+    {
+        return true;
+    }
+
+    struct nss_ovpn_sk_crypto_session key = { .tunnel_id = tun->id };
+    if (tun->old_key_id >= 0)
+    {
+        key.key_id = (uint8_t)tun->old_key_id;
+        if (ioctl(nss_fd, NSS_OVPN_SK_SIOC_CRYPTO_KEY_DEL, &key) < 0)
+        {
+            return false;
+        }
+    }
+
+    if (!ks->nss_key)
+    {
+        return false;
+    }
+    key = *ks->nss_key;
+    key.tunnel_id = tun->id;
+    int ret = ioctl(nss_fd, NSS_OVPN_SK_SIOC_CRYPTO_KEY_ADD, &key);
+    secure_memzero(&key, sizeof(key));
+    if (ret < 0)
+    {
+        return false;
+    }
+
+    tun->old_key_id = tun->key_id;
+    tun->key_id = ks->key_id;
+    return true;
+}
+
+bool
+nss_dca_packet(struct context *c, bool decrypt)
+{
+    struct tls_multi *multi = c->c2.tls_multi;
+    if (!multi || !multi->nss_dca || multi->multi_state < CAS_CONNECT_DONE || c->c2.buf.len <= 0)
+    {
+        return false;
+    }
+
+    if (decrypt)
+    {
+        const uint8_t opcode = *BPTR(&c->c2.buf) >> P_OPCODE_SHIFT;
+        if (opcode != P_DATA_V1 && opcode != P_DATA_V2)
+        {
+            return false;
+        }
+    }
+
+    const struct key_state *ks = get_primary_key(multi);
+    if (!c->c2.nss_attempted)
+    {
+        c->c2.nss_attempted = true;
+        if (ks->state == S_GENERATED_KEYS && ks->authenticated == KS_AUTH_TRUE
+            && nss_dca_eligible(c, ks))
+        {
+            nss_dca_start(c, ks);
+        }
+    }
+
+    struct nss_dca_tunnel *tun = c->c2.nss_tunnel;
+    if (!tun)
+    {
+        return false;
+    }
+
+    /*
+     * A tunnel that has sent or received data through NSS must stay on NSS
+     * until reconnect, because software does not share its replay window or
+     * transmit packet-ID state.
+     */
+    if (ks->state == S_GENERATED_KEYS && ks->authenticated == KS_AUTH_TRUE
+        && !nss_dca_rekey(tun, ks))
+    {
+        register_signal(c->sig, SIGUSR1, "nss-dca-rekey-failed");
+        return true;
+    }
+
+    if (decrypt && !addr_match_proto(&c->c2.from.dest, &ks->remote_addr.dest,
+                                     c->c2.link_sockets[0]->info.proto))
+    {
+        return true;
+    }
+
+    union {
+        struct cmsghdr align;
+        unsigned char data[CMSG_SPACE(sizeof(struct nss_ovpn_sk_pkt_info))];
+    } control = { 0 };
+    struct iovec iov = { .iov_base = BPTR(&c->c2.buf), .iov_len = BLEN(&c->c2.buf) };
+    struct msghdr msg_hdr = {
+        .msg_iov = &iov,
+        .msg_iovlen = 1,
+        .msg_control = control.data,
+        .msg_controllen = sizeof(control.data),
+    };
+    struct cmsghdr *cmsg = CMSG_FIRSTHDR(&msg_hdr);
+    cmsg->cmsg_level = SOL_IP;
+    cmsg->cmsg_type = IP_PKTINFO;
+    cmsg->cmsg_len = CMSG_LEN(sizeof(struct nss_ovpn_sk_pkt_info));
+
+    struct nss_ovpn_sk_pkt_info pkt = { .tunnel_id = tun->id };
+    if (decrypt)
+    {
+        pkt.flags = NSS_OVPN_SK_PKT_INFO_FLAG_DIR_DECAP;
+        if (ks->remote_addr.dest.addr.sa.sa_family == AF_INET6)
+        {
+            pkt.flags |= NSS_OVPN_SK_PKT_INFO_FLAG_PKT_TYPE_IPV6;
+        }
+    }
+    memcpy(CMSG_DATA(cmsg), &pkt, sizeof(pkt));
+
+    if (sendmsg(nss_fd, &msg_hdr, MSG_DONTWAIT) < 0)
+    {
+        dmsg(D_LINK_ERRORS, "NSS OpenVPN data submission failed");
+    }
+
+    return true;
+}
+
+void
+nss_dca_close(struct context *c)
+{
+    struct nss_dca_tunnel *tun = c->c2.nss_tunnel;
+    if (!tun)
+    {
+        return;
+    }
+
+    struct nss_dca_tunnel **entry = &tunnels;
+    while (*entry != tun)
+    {
+        entry = &(*entry)->next;
+    }
+    *entry = tun->next;
+
+    ioctl(nss_fd, NSS_OVPN_SK_SIOC_TUN_DEL, &tun->id);
+    c->c2.nss_tunnel = NULL;
+    free(tun);
+    nss_dca_release();
+}
+
+void
+nss_dca_event_set(struct event_set *es, void *arg)
+{
+    if (nss_fd >= 0)
+    {
+        event_ctl(es, nss_fd, EVENT_READ, arg);
+    }
+}
+
+void
+nss_dca_recv(void)
+{
+    union {
+        struct cmsghdr align;
+        unsigned char data[CMSG_SPACE(sizeof(struct nss_ovpn_sk_pkt_info))];
+    } control;
+    uint8_t data[512];
+    struct iovec iov = { .iov_base = data, .iov_len = sizeof(data) };
+    struct msghdr hdr = {
+        .msg_iov = &iov,
+        .msg_iovlen = 1,
+        .msg_control = control.data,
+        .msg_controllen = sizeof(control.data),
+    };
+
+    if (nss_fd < 0 || recvmsg(nss_fd, &hdr, MSG_DONTWAIT) <= 0
+        || (hdr.msg_flags & (MSG_TRUNC | MSG_CTRUNC)))
+    {
+        return;
+    }
+
+    const struct cmsghdr *cmsg = CMSG_FIRSTHDR(&hdr);
+    if (!cmsg || cmsg->cmsg_level != SOL_IP || cmsg->cmsg_type != IP_PKTINFO
+        || cmsg->cmsg_len < CMSG_LEN(sizeof(struct nss_ovpn_sk_pkt_info)))
+    {
+        return;
+    }
+
+    struct nss_ovpn_sk_pkt_info pkt;
+    memcpy(&pkt, CMSG_DATA(cmsg), sizeof(pkt));
+    for (struct nss_dca_tunnel *tun = tunnels; tun; tun = tun->next)
+    {
+        if (tun->id == pkt.tunnel_id)
+        {
+            event_timeout_reset(&tun->context->c2.ping_rec_interval);
+            return;
+        }
+    }
+}
+
+void
+nss_dca_stats(struct context *c)
+{
+    const struct nss_dca_tunnel *tun = c->c2.nss_tunnel;
+    if (!tun)
+    {
+        return;
+    }
+
+    struct nss_ovpn_sk_tun_stats stats = { .tunnel_id = tun->id };
+    if (ioctl(nss_fd, NSS_OVPN_SK_SIOC_STATS_GET, &stats) == 0)
+    {
+        c->c2.tun_write_bytes += stats.tun_write_bytes;
+        c->c2.link_read_bytes_auth += stats.link_read_bytes_auth;
+        c->c2.link_write_bytes += stats.link_write_bytes;
+        if (stats.link_read_bytes_auth)
+        {
+            event_timeout_reset(&c->c2.ping_rec_interval);
+        }
+    }
