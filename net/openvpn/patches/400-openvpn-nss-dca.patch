Subject: [PATCH] openvpn: support the QSDK12 NSS OpenVPN Manager

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>

--- a/configure.ac
+++ b/configure.ac
@@ -150,6 +150,17 @@
 	[enable_small="no"]
 )
 
+AC_ARG_ENABLE([nss-dca],
+    [AS_HELP_STRING([--enable-nss-dca], [enable Qualcomm NSS OpenVPN data channel acceleration])],
+    [enable_nss_dca="$enableval"], [enable_nss_dca=no])
+AS_IF([test "$enable_nss_dca" = yes], [
+    AC_CHECK_HEADER([nss_ovpn_sk.h], [], [AC_MSG_ERROR([NSS OpenVPN Manager headers required])], [[#include <stdint.h>
+#include <sys/types.h>
+#include <net/if.h>
+#include <linux/sockios.h>]])
+    AC_DEFINE([ENABLE_NSS_DCA], [1], [Enable Qualcomm NSS data channel acceleration])
+])
+
 AC_ARG_ENABLE(
 	[dco],
 	[AS_HELP_STRING([--disable-dco], [disable data channel offload support using the ovpn-dco kernel module @<:@default=yes@:>@ on Linux/FreeBSD, can't disable on Windows])],
