[global]
	netbios name = |NAME|
	server string = |DESCRIPTION|
	workgroup = |WORKGROUP|
	interfaces = |INTERFACES|
	bind interfaces only = yes
	ipc timeout = 20
	deadtime = 15
	map to guest = Bad User
	server max protocol = SMB3_11
	smb2 max read = 1MB
	smb2 max write = 1MB
	smb2 max trans = 1MB
	cache read buffers = no
	cache trans buffers = no
