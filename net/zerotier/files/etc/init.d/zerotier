#!/bin/sh /etc/rc.common

START=90

USE_PROCD=1

PROG=/usr/bin/zerotier-one
CONFIG_PATH=/var/lib/zerotier-one
RUN_PATH=/var/run/zerotier-one

network_ids=""

join_network() {
	local section="$1" enabled id allow_managed allow_global allow_default allow_dns
	config_get_bool enabled "$section" enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get id "$section" id
	config_get_bool allow_managed "$section" allow_managed 1
	config_get_bool allow_global "$section" allow_global 0
	config_get_bool allow_default "$section" allow_default 0
	config_get_bool allow_dns "$section" allow_dns 0
	[ -n "$id" ] || return
	network_ids="$network_ids $id"
	touch "$CONFIG_PATH/networks.d/$id.conf"
	echo "allowManaged=$allow_managed" > "$CONFIG_PATH/networks.d/$id.local.conf"
	echo "allowGlobal=$allow_global" >> "$CONFIG_PATH/networks.d/$id.local.conf"
	echo "allowDefault=$allow_default" >> "$CONFIG_PATH/networks.d/$id.local.conf"
	echo "allowDNS=$allow_dns" >> "$CONFIG_PATH/networks.d/$id.local.conf"
}

start_service() {
	config_load zerotier
	local enabled port secret local_conf_path config_path copy_config_path args=""
	config_get_bool enabled global enabled 0
	config_get port global port
	config_get secret global secret
	config_get local_conf_path global local_conf_path
	config_get config_path global config_path
	# Keep persistent planet/moon files while confining runtime writes to RAM.
	config_get_bool copy_config_path global copy_config_path 1
	[ "$enabled" -ne 0 ] || { echo "disabled in /etc/config/zerotier"; return; }
	rm -rf "$CONFIG_PATH"
	if [ -n "$config_path" ]; then
		mkdir -p "$config_path" || { echo "Unable to create ZeroTier config_path: $config_path" >&2; return 1; }
		[ "$copy_config_path" -eq 1 ] && cp -r "$config_path" "$CONFIG_PATH" || ln -s "$config_path" "$CONFIG_PATH"
	fi
	mkdir -p "$CONFIG_PATH/networks.d"
	network_ids=""
	config_foreach join_network network
	# Persistent configuration may contain disabled or removed networks.
	local conf id
	for conf in "$CONFIG_PATH"/networks.d/*.conf; do
		id="${conf##*/}"
		id="${id%%.*}"
		case " $network_ids " in
			*" $id "*) ;;
			*) rm -f "$conf" ;;
		esac
	done
	[ -f "$local_conf_path" ] && ln -s "$local_conf_path" "$CONFIG_PATH/local.conf"
	[ -n "$port" ] && args="$args -p$port"
	if [ -z "$secret" ]; then
		echo -n "Generating secret - please wait... "
		secret="$(zerotier-idtool generate)" || return 1
		uci set zerotier.global.secret="$secret"; uci commit zerotier; echo done.
	fi
	[ -n "$secret" ] && { echo "$secret" > "$CONFIG_PATH/identity.secret"; rm -f "$CONFIG_PATH/identity.public"; }
	procd_open_instance
	procd_set_param command $PROG $args
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}

service_started() {
	zerotier-fw4 -s
}

stop_service() {
	rm -rf "$CONFIG_PATH" "$RUN_PATH"
	fw4 reload >/dev/null 2>&1
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger 'zerotier'
}
