 #include "AES.hpp"
 
 #include "Constants.hpp"
+
+#if defined(__linux__)
+#include <sys/socket.h>
+#include <linux/if_alg.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+
+#ifndef AF_ALG
+#define AF_ALG 38
+#endif
+#ifndef SOL_ALG
+#define SOL_ALG 279
+#endif
+#ifndef ALG_SET_KEY
+#define ALG_SET_KEY 1
+#endif
+#ifndef ALG_SET_IV
+#define ALG_SET_IV 2
+#endif
+
+namespace ZeroTier {
+namespace {
+
+// Dynamically probe if the Linux kernel has an active EIP-93 crypto driver
+static bool isEIP93Available() noexcept
+{
+	static int status = -1; // -1: unprobed, 0: unavailable, 1: available
+	if (status >= 0) return (status == 1);
+
+	// Explicit opt-out via environment variable
+	const char* env = ::getenv("ZEROTIER_EIP93");
+	if (env && ::strcmp(env, "off") == 0) {
+		status = 0;
+		return false;
+	}
+
+	// Dynamic probe via AF_ALG skcipher bind
+	int tfmFd = ::socket(AF_ALG, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+	if (tfmFd < 0) {
+		status = 0;
+		return false;
+	}
+
+	struct sockaddr_alg sa = {};
+	sa.salg_family = AF_ALG;
+	::strncpy((char*)sa.salg_type, "skcipher", sizeof(sa.salg_type) - 1);
+	::strncpy((char*)sa.salg_name, "ctr(aes-eip93)", sizeof(sa.salg_name) - 1);
+
+	if (::bind(tfmFd, (struct sockaddr*)&sa, sizeof(sa)) == 0) {
+		::close(tfmFd);
+		status = 1;
+		fprintf(stderr, "ZeroTier: EIP-93 hardware AES-CTR accelerator detected via AF_ALG\n");
+		return true;
+	}
+
+	::close(tfmFd);
+	status = 0;
+	return false;
+}
+
+} // namespace
+
+bool AES::CTR::p_eip93Crypt(const uint8_t* in, uint8_t* out, unsigned int len) noexcept
+{
+	// 1. Bypass EIP-93 if CPU has native AES or packet is small (< 256 bytes)
+#if defined(ZT_AES_AESNI)
+	if (Utils::CPUID.aes) return false;
+#endif
+#if defined(ZT_ARCH_ARM_HAS_NEON)
+	if (Utils::ARMCAP.aes) return false;
+#endif
+	if (len < 256) return false;
+
+	// 2. Open / reuse persistent AF_ALG operational socket
+	if (_eip93Fd < 0) {
+		if (!isEIP93Available()) {
+			return false;
+		}
+
+		int tfmFd = ::socket(AF_ALG, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+		if (tfmFd < 0) return false;
+
+		struct sockaddr_alg sa = {};
+		sa.salg_family = AF_ALG;
+		::strncpy((char*)sa.salg_type, "skcipher", sizeof(sa.salg_type) - 1);
+		::strncpy((char*)sa.salg_name, "ctr(aes-eip93)", sizeof(sa.salg_name) - 1);
+
+		if (::bind(tfmFd, (struct sockaddr*)&sa, sizeof(sa)) != 0 ||
+			::setsockopt(tfmFd, SOL_ALG, ALG_SET_KEY, _aes.rawKey(), 32) != 0) {
+			::close(tfmFd);
+			return false;
+		}
+
+		_eip93Fd = ::accept4(tfmFd, NULL, NULL, SOCK_CLOEXEC);
+		::close(tfmFd);
+		if (_eip93Fd < 0) return false;
+
+		struct timeval tv = { 1, 0 };
+		::setsockopt(_eip93Fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+		::setsockopt(_eip93Fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+	}
+
+	const unsigned int alignedLen = len & ~15U;
+	const unsigned int rem = len & 15U;
+
+	char cbuf[CMSG_SPACE(sizeof(struct af_alg_iv) + 16)] = {};
+	struct msghdr msg = {};
+	msg.msg_control = cbuf;
+	msg.msg_controllen = sizeof(cbuf);
+
+	struct cmsghdr* cmsg = CMSG_FIRSTHDR(&msg);
+	cmsg->cmsg_level = SOL_ALG;
+	cmsg->cmsg_type = ALG_SET_IV;
+	cmsg->cmsg_len = CMSG_LEN(sizeof(struct af_alg_iv) + 16);
+
+	struct af_alg_iv* ivMsg = (struct af_alg_iv*)CMSG_DATA(cmsg);
+	ivMsg->ivlen = 16;
+	::memcpy(ivMsg->iv, _ctr, 16);
+
+	struct iovec iov = { (void*)in, alignedLen };
+	msg.msg_iov = &iov;
+	msg.msg_iovlen = 1;
+
+	if (::sendmsg(_eip93Fd, &msg, 0) != (ssize_t)alignedLen ||
+		::read(_eip93Fd, out, alignedLen) != (ssize_t)alignedLen) {
+		::close(_eip93Fd);
+		_eip93Fd = -1;
+		return false;
+	}
+
+	const uint32_t numBlocks = alignedLen / 16;
+	reinterpret_cast<uint32_t*>(_ctr)[3] = Utils::hton(Utils::ntoh(reinterpret_cast<uint32_t*>(_ctr)[3]) + numBlocks);
+
+	if (rem > 0) {
+		::memcpy(out + alignedLen, in + alignedLen, rem);
+	}
+
+	_len += len;
+	return true;
+}
+
+} // namespace ZeroTier
+#endif
+
+namespace ZeroTier {
+
+bool AES::hasHardwareAcceleration() noexcept
+{
+	// Tier 1: CPU native AES hardware instructions (AES-NI / ARMv8 Crypto)
+#ifdef ZT_AES_AESNI
+	if (likely(Utils::CPUID.aes)) return true;
+#endif
+#ifdef ZT_ARCH_ARM_HAS_NEON
+#ifdef ZT_AES_NEON
+	if (Utils::ARMCAP.aes) return true;
+#endif
+#endif
+
+	// Tier 2: Dedicated hardware crypto coprocessor (EIP-93) via dynamic kernel probe
+#if defined(__linux__)
+	if (isEIP93Available()) return true;
+#endif
+
+	// Tier 3: No hardware acceleration available -> will trigger Salsa20/12-Poly1305 fallback
+	return false;
+}
+
+} // namespace ZeroTier
 
