From: Mike Brady <mikebrady@eircom.net>
Subject: [PATCH] use the supported-config API with FFmpeg 7.1+

Backport the current upstream compatibility code for FFmpeg versions that no
longer expose AVCodec::sample_fmts.

Signed-off-by: coolsnowwolf <coolsnowwolf@gmail.com>
---
--- a/shairport.c
+++ b/shairport.c
@@ -160,12 +160,21 @@
   int has_capability = 0;
   const AVCodec *codec = avcodec_find_decoder(AV_CODEC_ID_AAC);
   if (codec != NULL) {
-    const enum AVSampleFormat *p = codec->sample_fmts;
-    if (p != NULL) {
-      while ((has_capability == 0) && (*p != AV_SAMPLE_FMT_NONE)) {
-        if (*p == AV_SAMPLE_FMT_FLTP)
+    const enum AVSampleFormat *formats = NULL;
+#if LIBAVCODEC_VERSION_INT >= AV_VERSION_INT(61, 13, 100)
+    int format_count = 0;
+    if ((avcodec_get_supported_config(NULL, codec, AV_CODEC_CONFIG_SAMPLE_FORMAT, 0,
+                                      (const void **)&formats, &format_count) < 0) ||
+        (format_count == 0))
+      formats = NULL;
+#else
+    formats = codec->sample_fmts;
+#endif
+    if (formats != NULL) {
+      while ((has_capability == 0) && (*formats != AV_SAMPLE_FMT_NONE)) {
+        if (*formats == AV_SAMPLE_FMT_FLTP)
           has_capability = 1;
-        p++;
+        formats++;
       }
     }
   }
